{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zapret Hub",
  "mainBinaryName": "zapret-hub",
  "identifier": "ZapretHub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Mai-kun/zapret-hub-linux/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEQTM1OTY0MzgwMkU0MUMKUldRYzVBSTRaRm1qamVSZmkzK2Nnd2hmMkZmREtLS1hKWDFGTHdCVkY2RVJQZUdyU3NkNktaZTAK"
    }
  }
}
